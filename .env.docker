# Docker Environment Configuration
# Copy this file to .env and fill in your actual values for Docker deployment

# APP
PORT=4000
NODE_ENV=production

# REDIS (for docker-compose, use 'redis' as host, for hosted Redis use your host)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_USERNAME=default

# FIREBASE
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Firebase-Private-Key-Here\n-----END PRIVATE KEY-----\n"
